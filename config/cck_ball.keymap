#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;//lt的延迟时间
    flavor = "balanced";
    quick-tap-ms = <150>;//按下lt后，150ms内按住不松开，就一直是单击的这个按键，而不是切层的效果。150ms以内的这个时间是关键
};

/ {
    combos {
        compatible = "zmk,combos";

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <51 56>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <52 55>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC           &kp N1        &kp N2        &kp N3     &kp N4     &kp N5            &kp N6  &kp N7         &kp N8        &kp N9          &kp N0          &kp BACKSPACE
&kp TAB           &kp Q         &kp W         &kp E      &kp R      &kp T             &kp Y   &kp U          &kp I         &kp O           &kp P           &kp BSLH
&mo 1             &kp A         &kp S         &kp D      &kp F      &kp G             &kp H   &kp J          &kp K         &kp L           &kp SEMI        &kp SQT
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C      &kp V      &kp B             &kp N   &kp M          &kp COMMA     &kp DOT         &kp UP_ARROW    &kp FSLH
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &kp SPACE  &lt 3 ESC  &mt LEFT_GUI TAB  &mo 2   &kp BACKSPACE  &lt 5 RETURN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        F_layers {
            bindings = <
&kp F12  &kp F1  &kp F2     &kp F3     &kp F4     &kp F5  &kp F6          &kp F7          &kp F8          &kp F9           &kp F10  &kp F11
&kp A    &kp Y   &kp U      &kp I      &kp O      &trans  &none           &none           &none           &trans           &trans   &trans
&none    &none   &mkp MCLK  &mkp LCLK  &mkp RCLK  &mo 4   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW  &trans   &trans
&trans   &trans  &trans     &trans     &trans     &none   &none           &none           &trans          &trans           &none    &trans
&trans   &trans  &trans     &mo 4      &trans     &trans  &mkp LCLK       &mkp RCLK       &kp LEFT_SHIFT  &trans           &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans  &trans  &trans  &trans  &kp W
&trans  &trans          &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans        &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        scroll-layers {
            bindings = <
&to 0   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &to 8   &trans  &mo 6   &mo 7   &to 6   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &none   &trans  &trans  &trans  &to 0   &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &mkp MCLK  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        symbol {
            bindings = <
&trans     &trans        &trans         &trans          &trans            &trans         &trans           &trans                &trans                 &trans             &trans           &kp DELETE
&trans     &kp LS(EXCL)  &kp LS(AT)     &kp LS(POUND)   &kp LS(DLLR)      &kp LS(PRCNT)  &kp BACKSLASH    &kp PIPE              &kp LEFT_BRACKET       &kp RIGHT_BRACKET  &kp AMPERSAND    &trans
&kp LSHFT  &kp PLUS      &kp SEMICOLON  &kp SQT         &kp COMMA         &kp DOT        &kp SLASH        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACE     &kp RIGHT_BRACE  &trans
&kp LSHFT  &kp ASTERISK  &kp MINUS      &kp EQUAL       &kp GREATER_THAN  &kp QUESTION   &kp EXCLAMATION  &kp QUESTION          &kp CARET              &kp AMPERSAND      &trans           &trans
&trans     &trans        &trans         &kp LEFT_SHIFT  &kp LC(C)         &kp LC(V)      &trans           &trans                &none                  &trans             &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        scroll-snipe {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &to 3   &to 0   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fast-scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &to 0   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        perma-scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &to 0   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
